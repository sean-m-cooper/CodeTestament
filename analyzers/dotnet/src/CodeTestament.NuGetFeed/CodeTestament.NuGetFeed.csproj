    <Compile Include="../CodeMetrics.AI/Probes/PackageMetadataRanges.cs" Link="Shared/PackageMetadataRanges.cs" />
    <Compile Include="../CodeMetrics.AI/Probes/PackageZipDirectory.cs" Link="Shared/PackageZipDirectory.cs" />
    <Compile Include="../CodeMetrics.AI/Probes/NuGetPackageClient.cs" Link="Shared/NuGetPackageClient.cs" />
    <Compile Include="../CodeMetrics.AI/Probes/NuGetServiceIndexClient.cs" Link="Shared/NuGetServiceIndexClient.cs" />
    <Compile Include="../CodeMetrics.AI/Probes/LocalPackageFrameworkResolver.cs" Link="Shared/LocalPackageFrameworkResolver.cs" />
    <Compile Include="../CodeMetrics.AI/Probes/PackageFeedProtocol.cs" Link="Shared/PackageFeedProtocol.cs" />
  </ItemGroup>
</Project>
