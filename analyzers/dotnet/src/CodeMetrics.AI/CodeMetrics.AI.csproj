<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>codetestament-dotnet</ToolCommandName>
    <PackageId>CodeTestament.Scorecard</PackageId>
    <Version>2.4.2</Version>
    <Description>Deterministic code metrics and scorecard evidence for .NET solutions</Description>
    <Authors>Sean Cooper</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sean-m-cooper/CodeTestament</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sean-m-cooper/CodeTestament</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>code-metrics;roslyn;static-analysis;scorecard;dotnet-tool</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CodeMetrics.AI.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="Rules\rules.json" LogicalName="CodeMetrics.AI.Rules.rules.json" />
    <None Update="Rules\rules.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Rules\rules.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" />
    <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../CodeTestament.NuGetFeed/CodeTestament.NuGetFeed.csproj" ReferenceOutputAssembly="false" Private="false" PrivateAssets="all" ExcludeAssets="all" />
  </ItemGroup>
  <Target Name="IncludeNuGetFeedHelper" BeforeTargets="GetCopyToOutputDirectoryItems;GetCopyToPublishDirectoryItems" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <_NuGetFeedFile Include="../CodeTestament.NuGetFeed/bin/$(Configuration)/net10.0/**/*" />
      <ContentWithTargetPath Include="@(_NuGetFeedFile)" TargetPath="NuGetFeedHelper/%(_NuGetFeedFile.RecursiveDir)%(_NuGetFeedFile.Filename)%(_NuGetFeedFile.Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
